@page
@model RazorPages.Pages.ProfileForms.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Form</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Form.Id" />
            <div class="form-group">
                <label asp-for="Form.firstName" class="control-label"></label>
                <input asp-for="Form.firstName" class="form-control" />
                <span asp-validation-for="Form.firstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Form.age" class="control-label"></label>
                <input asp-for="Form.age" class="form-control" />
                <span asp-validation-for="Form.age" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Form.lastName" class="control-label"></label>
                <input asp-for="Form.lastName" class="form-control" />
                <span asp-validation-for="Form.lastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Form.job" class="control-label"></label>
                <input asp-for="Form.job" class="form-control" />
                <span asp-validation-for="Form.job" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
