@page
@model RazorPages.Pages.ProfileForms.KendoGridModel
@{
    ViewData["Title"] = "Profile Data - Kendo Grid";
}

<h2>Profile Information</h2>

<div class="row">
    <div class="col-md-12">
        <h4>Interactive Grid (no jQuery)</h4>
        <div id="grid"></div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a asp-page="CreateForm" class="btn btn-primary">Add New Profile</a>
                <a asp-page="Index" class="btn btn-secondary">Back to Simple View</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const pageSizes = [5, 10, 15, "All"];

            function debounce(fn, delay) {
                let t;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), delay);
                };
            }

            document.addEventListener('DOMContentLoaded', function () {
                const container = document.getElementById('grid');
                if (!container) return;

                // single-table grid state
                let data = [];
                let filtered = [];
                let currentPage = 1;
                let pageSize = 10;
                let sortField = null;
                let sortDir = 1; // 1 = asc, -1 = desc
                const columns = [
                    { field: 'Id', title: 'ID' },
                    { field: 'firstName', title: 'First Name' },
                    { field: 'lastName', title: 'Last Name' },
                    { field: 'age', title: 'Age' },
                    { field: 'job', title: 'Job' }
                ];

                // build UI
                container.innerHTML = '';
                const toolbar = document.createElement('div');
                toolbar.className = 'mb-2 d-flex justify-content-between';

                const leftControls = document.createElement('div');
                const pageSizeSelect = document.createElement('select');
                pageSizes.forEach(ps => {
                    const opt = document.createElement('option');
                    opt.value = ps === 'All' ? '0' : String(ps);
                    opt.text = String(ps);
                    pageSizeSelect.appendChild(opt);
                });
                pageSizeSelect.value = String(pageSize);
                pageSizeSelect.addEventListener('change', () => {
                    pageSize = Number(pageSizeSelect.value) || filtered.length || data.length;
                    currentPage = 1;
                    render();
                });
                leftControls.appendChild(document.createTextNode('Page size: '));
                leftControls.appendChild(pageSizeSelect);

                const rightControls = document.createElement('div');
                const paginationHolder = document.createElement('div');
                rightControls.appendChild(paginationHolder);

                toolbar.appendChild(leftControls);
                toolbar.appendChild(rightControls);

                container.appendChild(toolbar);

                const table = document.createElement('table');
                table.className = 'table table-striped table-hover';
                const thead = document.createElement('thead');
                const headerRow = document.createElement('tr');
                const filterRow = document.createElement('tr');

                columns.forEach(col => {
                    const th = document.createElement('th');
                    th.textContent = col.title;
                    th.style.cursor = 'pointer';
                    th.addEventListener('click', () => {
                        if (sortField === col.field) sortDir = -sortDir; else { sortField = col.field; sortDir = 1; }
                        applySort(); render();
                    });
                    headerRow.appendChild(th);

                    const fth = document.createElement('th');
                    const input = document.createElement('input');
                    input.className = 'form-control form-control-sm';
                    input.placeholder = 'Filter...';
                    input.dataset.field = col.field;
                    input.addEventListener('input', debounce(onFilterChange, 300));
                    fth.appendChild(input);
                    filterRow.appendChild(fth);
                });

                thead.appendChild(headerRow);
                thead.appendChild(filterRow);
                table.appendChild(thead);

                const tbody = document.createElement('tbody');
                table.appendChild(tbody);

                container.appendChild(table);

                async function fetchData() {
                    try {
                        const res = await fetch('/ProfileForms/KendoGrid?handler=Data');
                        if (!res.ok) throw new Error('Network response was not ok');
                        data = await res.json();
                        filtered = data.slice();
                        if (!Number(pageSizeSelect.value)) pageSize = filtered.length;
                        render();
                    } catch (e) {
                        console.error('Failed to fetch data:', e);
                        container.innerHTML = '<div class="alert alert-danger">Failed to load grid data</div>';
                    }
                }

                function onFilterChange() {
                    const inputs = Array.from(filterRow.querySelectorAll('input'));
                    const criteria = {};
                    inputs.forEach(i => {
                        if (i.value && i.value.trim() !== '') criteria[i.dataset.field] = i.value.trim();
                    });
                    applyFilters(criteria);
                    currentPage = 1;
                    render();
                }

                function applyFilters(criteria) {
                    filtered = data.filter(item => {
                        for (const key in criteria) {
                            const val = String((item[key] === null || item[key] === undefined) ? '' : item[key]).toLowerCase();
                            const crit = String(criteria[key]).toLowerCase();
                            if (!val.includes(crit)) return false;
                        }
                        return true;
                    });
                    applySort();
                }

                function applySort() {
                    if (!sortField) return;
                    filtered.sort((a, b) => {
                        const av = a[sortField];
                        const bv = b[sortField];
                        if (av == null && bv == null) return 0;
                        if (av == null) return -1 * sortDir;
                        if (bv == null) return 1 * sortDir;
                        if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * sortDir;
                        return String(av).localeCompare(String(bv)) * sortDir;
                    });
                }

                function render() {
                    tbody.innerHTML = '';
                    const total = filtered.length;
                    const effectivePageSize = pageSize === 0 ? total : pageSize;
                    const totalPages = effectivePageSize ? Math.max(1, Math.ceil(total / effectivePageSize)) : 1;
                    if (currentPage > totalPages) currentPage = totalPages;
                    const start = (currentPage - 1) * effectivePageSize;
                    const pageItems = effectivePageSize ? filtered.slice(start, start + effectivePageSize) : filtered.slice();

                    pageItems.forEach(item => {
                        const tr = document.createElement('tr');
                        columns.forEach(col => {
                            const td = document.createElement('td');
                            td.textContent = item[col.field] ?? '';
                            tr.appendChild(td);
                        });
                        tbody.appendChild(tr);
                    });

                    renderPagination(paginationHolder, total, effectivePageSize, totalPages);
                }

                function renderPagination(holder, total, effectivePageSize, totalPages) {
                    holder.innerHTML = '';
                    if (totalPages <= 1) return;
                    const nav = document.createElement('nav');
                    const ul = document.createElement('ul');
                    ul.className = 'pagination pagination-sm mb-0';

                    const makePageItem = (p, label) => {
                        const li = document.createElement('li');
                        li.className = 'page-item' + (p === currentPage ? ' active' : '');
                        const a = document.createElement('a');
                        a.className = 'page-link';
                        a.href = '#';
                        a.textContent = label ?? String(p);
                        a.addEventListener('click', (ev) => { ev.preventDefault(); currentPage = p; render(); });
                        li.appendChild(a);
                        return li;
                    };

                    const prev = document.createElement('li');
                    prev.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
                    const pa = document.createElement('a'); pa.className='page-link'; pa.href='#'; pa.textContent='‹';
                    pa.addEventListener('click', (ev) => { ev.preventDefault(); if (currentPage>1) { currentPage--; render(); } });
                    prev.appendChild(pa); ul.appendChild(prev);

                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, startPage + 4);
                    if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
                    for (let p = startPage; p <= endPage; p++) ul.appendChild(makePageItem(p));

                    const next = document.createElement('li');
                    next.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
                    const na = document.createElement('a'); na.className='page-link'; na.href='#'; na.textContent='›';
                    na.addEventListener('click', (ev) => { ev.preventDefault(); if (currentPage<totalPages) { currentPage++; render(); } });
                    next.appendChild(na); ul.appendChild(next);

                    nav.appendChild(ul);
                    holder.appendChild(nav);
                }

                fetchData();
            });
        })();
    </script>
}


<style>
    .k-grid {
        margin: 20px 0;
    }
    
    .k-grid-header {
        background-color: #f8f9fa;
        font-weight: bold;
    }
    
    .k-grid .k-table td {
        padding: 12px 8px;
    }
</style>

