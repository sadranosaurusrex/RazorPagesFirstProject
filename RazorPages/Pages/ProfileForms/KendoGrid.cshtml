@page
@model RazorPages.Pages.ProfileForms.KendoGridModel
@{
    ViewData["Title"] = "Profile Data - Kendo Grid";
}

<h2>Profile Information</h2>

<div class="row">
    <div class="col-md-5">
        <h4>Interactive Kendo Grid hahah :)</h4>
        <div id="grid"></div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <a asp-page="CreateForm" class="btn btn-primary">Add New Profile</a>
                <a asp-page="Index" class="btn btn-secondary">Back to Simple View</a>
            </div>
        </div>
        <h4>Server-Side HTML Table</h4>
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Age</th>
                        <th>Job</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in Model.Profiles)
                    {
                        <tr>
                            <td>@profile.Id</td>
                            <td>@profile.firstName</td>
                            <td>@profile.lastName</td>
                            <td>@profile.age</td>
                            <td>@profile.job</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Profiles.Any())
        {
            <div class="alert alert-info">
                No profiles found. <a asp-page="CreateForm">Create one now</a>.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@@progress/kendo-react-grid@latest/dist/cdn/js/kendo-react-grid.js"></script>
    <script src="https://unpkg.com/@@progress/kendo-react-data-tools@latest/dist/cdn/js/kendo-react-data-tools.js"></script>
    <script src="https://unpkg.com/@@progress/kendo-react-intl@latest/dist/cdn/js/kendo-react-intl.js"></script>
    <script src="https://unpkg.com/@@progress/kendo-licensing@latest/dist/cdn/js/kendo-licensing.js"></script>
    
    <link rel="stylesheet" href="https://unpkg.com/@@progress/kendo-theme-default@latest/dist/all.css" />

    <script type="text/babel">
        const { Grid, GridColumn } = KendoReactGrid;
        const { process } = KendoReactDataQuery;
        const { useState, useEffect } = React;

        const ProfileGrid = () => {
            const [data, setData] = useState([]);
            const [dataState, setDataState] = useState({
                skip: 0,
                take: 10,
                sort: []
            });

            useEffect(() => {
                fetchData();
            }, []);

            const fetchData = async () => {
                try {
                    const response = await fetch('/ProfileForms/KendoGrid?handler=Data');
                    const profiles = await response.json();
                    setData(profiles);
                } catch (error) {
                    console.error('Error fetching data:', error);
                }
            };

            const dataStateChange = (event) => {
                setDataState(event.dataState);
            };

            const processedData = process(data, dataState);

            return (
                <Grid
                    style={{ height: '500px' }}
                    data={processedData}
                    {...dataState}
                    onDataStateChange={dataStateChange}
                    sortable={true}
                    filterable={true}
                    pageable={{
                        buttonCount: 4,
                        info: true,
                        type: 'numeric',
                        pageSizes: [5, 10, 15, 'All'],
                        previousNext: true
                    }}
                >
                    <GridColumn field="id" title="ID" width="80px" filterable={false} />
                    <GridColumn field="firstName" title="First Name" />
                    <GridColumn field="lastName" title="Last Name" />
                    <GridColumn field="age" title="Age" width="100px" />
                    <GridColumn field="job" title="Job" />
                </Grid>
            );
        };

        ReactDOM.render(<ProfileGrid />, document.getElementById('grid'));
    </script>
    
    <script src="https://unpkg.com/@@babel/standalone/babel.min.js"></script>
}

<style>
    .k-grid {
        margin: 20px 0;
    }
    
    .k-grid-header {
        background-color: #f8f9fa;
        font-weight: bold;
    }
    
    .k-grid .k-table td {
        padding: 12px 8px;
    }
</style>

